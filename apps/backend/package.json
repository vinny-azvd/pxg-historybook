{
  "name": "@pxg-hunts/backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "backup": "tsx src/scripts/backupDb.ts",
    "export": "tsx src/scripts/exportAll.ts",
    "build": "tsc -p tsconfig.json && node -e \"import('node:fs').then(fs=>fs.cpSync('src/db/schema.sql','dist/db/schema.sql'))\"",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
